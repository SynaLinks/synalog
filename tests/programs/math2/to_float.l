# ToFloat64 keeps the value.
# Expect: rows Q = [(1, 7.0), (2, -7.0), (3, 2.5), (4, -2.5), (5, 0.0), (6, 3.0), (7, 0.125), (8, 1000000.0), (9, -0.75), (10, 12.345)]
V(id: 1, x: 7);
V(id: 2, x: -7);
V(id: 3, x: 2.5);
V(id: 4, x: -2.5);
V(id: 5, x: 0);
V(id: 6, x: 3);
V(id: 7, x: 0.125);
V(id: 8, x: 1000000);
V(id: 9, x: -0.75);
V(id: 10, x: 12.345);
@OrderBy(Q, "id");
Q(id:, v: ToFloat64(x)) :- V(id:, x:);
