U(a:, b:) distinct :- E(a:, b:) | E(a: b, b: a);
@Recursive(Conn, 12);
Conn(a:, b:) distinct :- U(a:, b:);
Conn(a:, b: c) distinct :- Conn(a:, b:), U(a: b, b: c);
Comp(n:, c? Min= m) distinct :- Node(n:), (Conn(a: n, b: m) | m == n);
@OrderBy(Q, "c", "size");
Q(c:, size? += 1) distinct :- Comp(c:);
